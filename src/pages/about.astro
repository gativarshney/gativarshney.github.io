---
import Base from '@/layouts/Base.astro';
import Portrait from '@/components/Portrait.astro';
import Certificate from '@/components/Certificate.astro';
import LeetCode from '@/components/LeetCode.astro';
import Logo from '@/components/Logo.astro';
import jssLogo from '@/assets/logos/jss.png';
import qqLogo from '@/assets/logos/quinque.png';
import gsocMark from '@/assets/logos/gsoc-mark.svg';
import opLogo from '@/assets/logos/openprinting.png';
import lfLogo from '@/assets/logos/linuxfoundation.png';
import wocCert from '@/assets/certs/woc-5.jpg';
import gsocCert from '@/assets/certs/gsoc-2026.jpg';
import quinqueCert from '@/assets/certs/quinque-2026.jpg';
import { site } from '@/data/site';

---
<Base title="About" image="/og/about.png" description="About Gati Varshney: final-year CS (Data Science) student at JSS Academy of Technical Education, GSoC 2026 contributor at OpenPrinting, LeetCode Knight.">
  <section class="hero" data-hero>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" data-hero-eyebrow data-anim><span class="dot"></span>Index · About · Final-year CS&nbsp;student · Open&nbsp;to&nbsp;relocation</p>
        <h1 class="display" data-hero-title data-anim>A short file<br /><em>on the author.</em></h1>
        <p class="lede" data-hero-lede data-anim>I’m a final-year Computer Science (Data Science) student at JSS Academy of Technical Education, Noida, graduating in 2027. I spent this year building for OpenPrinting at The Linux Foundation, first as a contributor and then as a Google Summer of Code 2026 participant, and on cidx, a code index for AI coding agents that I maintain on PyPI.</p>
        <p class="lede second" data-anim data-reveal="0.9">What I care about is whether a system can prove its own claims. That shows up as decision records, evaluation harnesses, honest limitation sections, and numbers that travel with the commands that produced them.</p>
        <div class="ctas" data-hero-cta>
          <a class="btn fill" href={site.links.resume} target="_blank" rel="noopener" data-magnetic="0.3" data-anim>Résumé (PDF) <span class="arr">↗</span></a>
          <a class="btn" href={`mailto:${site.email}`} data-magnetic="0.3" data-anim>Email</a>
          <a class="btn ghost" href={site.links.linkedin} target="_blank" rel="noopener" data-magnetic="0.3" data-anim>LinkedIn <span class="arr">↗</span></a>
        </div>
      </div>
      <Portrait badge="Final-year CS · Class of 2027" />
    </div>
  </section>

  <section class="wrap section">
    <div class="col">
      <p class="eyebrow" data-reveal>Education</p>
      <ul class="rows" data-reveal-group="0.08">
        <li><span class="mono when">2023 – 2027</span><span class="marks"><Logo src={jssLogo} alt="JSS Academy of Technical Education, Noida" tone="jss" size={60} scale={0.9} /></span><div><h2>B.Tech, Computer Science &amp; Engineering (Data Science)</h2><p class="muted">JSS Academy of Technical Education, Noida · GPA 8.7 / 10</p></div></li>
      </ul>
      <p class="eyebrow" style="margin-top:48px" data-reveal>Experience</p>
      <ul class="rows" data-reveal-group="0.08">
        <li><span class="mono when">Sep 2026</span><span class="marks"><Logo src={qqLogo} alt="Quin Que" tone="qq" size={60} /></span><div><h2>Software Engineer Intern · Remote · Quin Que, a Japanese company</h2><p class="muted">An international internship with a Japanese company: Rapilogi, a warehouse reception management system. Private company work; public outline only.</p></div></li>
        <li><span class="mono when">May – Aug 2026</span><span class="marks"><Logo src={gsocMark} alt="Google Summer of Code" tone="gsoc" size={60} /><Logo src={lfLogo} alt="The Linux Foundation" tone="lf" size={60} /></span><div><h2>Google Summer of Code contributor · The Linux Foundation (OpenPrinting)</h2><p class="muted">Explainable printer recommendations and a natural-language assistant over the Foomatic database. Mentors: Till Kamppeter, Rudra Pratap Singh.</p></div></li>
        <li><span class="mono when">Nov 2025 – Aug 2026</span><span class="marks"><Logo src={opLogo} alt="OpenPrinting" tone="op" size={60} /></span><div><h2>Open-source contributor · OpenPrinting website</h2><p class="muted">Author system, migration of 200+ posts, production search, homepage, trailing-slash fix. 14 pull requests merged through maintainer review; Hall of Fame.</p></div></li>
      </ul>
      <p class="eyebrow" id="certificates" style="margin-top:48px" data-reveal>Certificates</p>
      <div class="certs">
        <Certificate src={gsocCert} alt="Google Summer of Code 2026 completion certificate for Gati Varshney, The Linux Foundation, May 25 to August 24, 2026" title="Google Summer of Code 2026" meta="The Linux Foundation · May 25 – Aug 24, 2026" compact />
        <Certificate src={wocCert} alt="Winter of Code 5.0 certificate: Gati Varshney, Top 20 Contributor, Google Developer Groups on Campus IIIT Kalyani" title="Winter of Code 5.0 · Top 20 Contributor" meta="GDG on Campus · IIIT Kalyani" verify={site.links.wocVerify} compact />
        <Certificate src={quinqueCert} alt="Certificate of Digital Internship from Quin Que, presented to Gati Varshney, Web and Smartphone Application Engineer, September 1st to September 30th, 2026, signed and sealed" title="Quin Que · Digital Internship" meta="Quin Que Inc. · remote · Sep 1 – Sep 30, 2026" compact />
      </div>
      <p class="eyebrow" style="margin-top:48px" data-reveal>Competitive programming</p>
      <LeetCode />
    </div>
  </section>
</Base>

<style>
  /* one centred column for everything under the hero */
  .col { max-width: 980px; margin-inline: auto; }
  .col :global(.lc) { max-width: none; }
  .certs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 18px; max-width: 980px; align-items: start; }
  @media (max-width: 860px) { .certs { grid-template-columns: 1fr; } }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .lede.second { font-size: 16.5px; }
  .section:first-of-type { padding-top: clamp(72px, 9vw, 120px); }
  .rows { border-top: 1px solid var(--hair); margin-top: 18px; max-width: 980px; }
  .rows li { display: grid; grid-template-columns: 140px 112px 1fr; gap: 24px 40px; padding: 24px 0; border-bottom: 1px solid var(--hair); align-items: center; }
  /* organisation marks: one badge per row, a pair overlaps when the work sat under two organisations */
  .marks { display: flex; align-items: center; }
  .marks > :global(* + *) { margin-left: -14px; }
  .when { font-size: 12px; color: var(--ink-2); }
  .rows h2 { font-size: 18px; font-weight: 500; margin-bottom: 6px; }
  .rows .muted { font-size: 15px; }
  @media (max-width: 860px) {
    .rows li { grid-template-columns: 1fr; gap: 10px; }
    .marks { margin: 4px 0 8px; }
  }
</style>
