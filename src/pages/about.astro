---
import Base from '@/layouts/Base.astro';
import Portrait from '@/components/Portrait.astro';
import { site } from '@/data/site';

---
<Base title="About" description="About Gati Varshney: final-year CS (Data Science) student at JSS Academy of Technical Education, GSoC 2026 contributor at OpenPrinting, LeetCode Knight.">
  <section class="hero" data-hero>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" data-hero-eyebrow data-anim><span class="dot"></span>Index · About · Final-year CS&nbsp;student · Open&nbsp;to&nbsp;relocation</p>
        <h1 class="display" data-hero-title data-anim>A short file<br /><em>on the author.</em></h1>
        <p class="lede" data-hero-lede data-anim>I’m a final-year Computer Science (Data Science) student at JSS Academy of Technical Education, Noida, graduating in 2027. I spent this year building for OpenPrinting at The Linux Foundation, first as a contributor and then as a Google Summer of Code 2026 participant, and on cidx, a code index for AI coding agents that I maintain on PyPI.</p>
        <p class="lede second" data-anim data-reveal="0.9">What I care about is whether a system can prove its own claims. That shows up as decision records, evaluation harnesses, honest limitation sections, and numbers that travel with the commands that produced them.</p>
        <div class="ctas" data-hero-cta>
          <a class="btn fill" href={site.links.resume} target="_blank" rel="noopener" data-magnetic="0.3" data-anim>Résumé (PDF) <span class="arr">↗</span></a>
          <a class="btn" href={`mailto:${site.email}`} data-magnetic="0.3" data-anim>Email</a>
          <a class="btn ghost" href={site.links.linkedin} target="_blank" rel="noopener" data-magnetic="0.3" data-anim>LinkedIn <span class="arr">↗</span></a>
        </div>
      </div>
      <Portrait badge="Final-year CS · Class of 2027" />
    </div>
  </section>

  <section class="wrap section">
    <div>
      <p class="eyebrow" data-reveal>Education</p>
      <ul class="rows" data-reveal-group="0.08">
        <li><span class="mono when">2023 – 2027</span><div><h2>B.Tech, Computer Science &amp; Engineering (Data Science)</h2><p class="muted">JSS Academy of Technical Education, Noida · GPA 8.7 / 10</p></div></li>
      </ul>
      <p class="eyebrow" style="margin-top:48px" data-reveal>Experience</p>
      <ul class="rows" data-reveal-group="0.08">
        <li><span class="mono when">2026</span><div><h2>Software Engineer Intern · Quin Que, Kobe, Japan</h2><p class="muted">An international internship with a Japanese company: Rapilogi, a warehouse reception management system. Private company work; public outline only.</p></div></li>
        <li><span class="mono when">May – Aug 2026</span><div><h2>Google Summer of Code contributor · The Linux Foundation (OpenPrinting)</h2><p class="muted">Explainable printer recommendations and a natural-language assistant over the Foomatic database. Mentors: Till Kamppeter, Rudra Pratap Singh.</p></div></li>
        <li><span class="mono when">Nov 2025 – present</span><div><h2>Open-source contributor · OpenPrinting website</h2><p class="muted">Author system, migration of 200+ posts, production search, homepage, trailing-slash fix. 14 commits in the production repository; Hall of Fame.</p></div></li>
      </ul>
      <p class="eyebrow" style="margin-top:48px" data-reveal>Competitive programming</p>
      <ul class="rows" data-reveal-group="0.08">
        <li><span class="mono when">as of Sep 2026</span><div><h2>LeetCode Knight</h2><p class="muted">Contest rating 1925 · top 3.98% of contest participants · 700+ problems solved · <a class="u" href={site.links.leetcode} target="_blank" rel="noopener">profile ↗</a></p></div></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .lede.second { font-size: 16.5px; }
  .section:first-of-type { padding-top: clamp(72px, 9vw, 120px); }
  .rows { border-top: 1px solid var(--hair); margin-top: 18px; max-width: 860px; }
  .rows li { display: grid; grid-template-columns: 140px 1fr; gap: 28px; padding: 22px 0; border-bottom: 1px solid var(--hair); }
  .when { font-size: 12px; color: var(--ink-2); padding-top: 4px; }
  .rows h2 { font-size: 18px; font-weight: 500; margin-bottom: 6px; }
  .rows .muted { font-size: 15px; }
  @media (max-width: 860px) {
    .rows li { grid-template-columns: 1fr; gap: 6px; }
  }
</style>
