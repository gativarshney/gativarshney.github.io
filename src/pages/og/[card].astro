---
// Templates for the Open Graph images (1200×630), one per page. Each is screenshotted
// into public/ (og-default.png, og/<card>.png). Not linked from anywhere; excluded
// from the sitemap; noindex.
import '@/styles/global.css';
import { Image } from 'astro:assets';
import portrait from '@/assets/gati-cutout.png';

const cards: Record<string, [title: string, sub: string]> = {
  default: ['Software that|proves itself.', 'Final-year CS student · GSoC 2026 contributor at OpenPrinting, The Linux Foundation'],
  work: ['Built to be|checked.', 'Projects with their evidence: RepoInsight, cidx, the GSoC printer recommendations, and the OpenPrinting site search'],
  cidx: ['A code index|for AI agents.', 'cidx · zero-config and local · five read-only MCP tools · try it in the browser'],
  repoinsight: ['Know a repo|before your first PR.', 'RepoInsight · ten questions about any public GitHub repository, answered with evidence'],
  'printer-recommendations': ['What else|will work?', 'Explainable recommendations across 6,657 printers · Google Summer of Code 2026 at OpenPrinting'],
  'openprinting-search': ['Search with|no server.', 'A build-time index and in-browser ranking, live on openprinting.github.io'],
  'open-source': ['Ten months in|one codebase.', 'OpenPrinting, The Linux Foundation · 14 pull requests merged · Hall of Fame'],
  writing: ['Notes from|the debugging.', 'Long-form write-ups, starting with the GSoC 2026 final report'],
  about: ['A short file|on the author.', 'Final-year CS (Data Science) · JSS Academy of Technical Education · class of 2027'],
};
export function getStaticPaths() {
  return ['default', 'work', 'cidx', 'repoinsight', 'printer-recommendations', 'openprinting-search', 'open-source', 'writing', 'about'].map((card) => ({ params: { card } }));
}
const [title, sub] = cards[Astro.params.card!];
const [line1, line2] = title.split('|');
---
<html lang="en" data-theme="light">
  <head><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>og</title></head>
  <body>
    <div class="og">
      <div class="left">
        <p class="eyebrow"><span class="dot"></span>gativarshney.github.io</p>
        <h1 class="display">{line1}{line2 && <><br /><em>{line2}</em></>}</h1>
        <p class="sub">{sub}</p>
        <p class="name">Gati <em>Varshney</em></p>
      </div>
      <div class="right"><div class="orb"></div><div class="portrait"><Image src={portrait} alt="" width={520} /></div></div>
    </div>
  </body>
</html>
<style>
  html, body { margin: 0; width: 1200px; height: 630px; overflow: hidden; }
  .og { width: 1200px; height: 630px; display: grid; grid-template-columns: 1fr 400px; padding: 64px 0 64px 72px; box-sizing: border-box; position: relative; }
  .left { display: flex; flex-direction: column; justify-content: flex-end; gap: 22px; }
  .eyebrow { position: absolute; top: 64px; left: 72px; }
  h1 { font-size: 78px; line-height: 0.98; margin: 0; }
  .sub { font-size: 21px; color: var(--ink-2); max-width: 640px; margin: 0; }
  .name { font-family: var(--font-display); font-size: 26px; margin: 8px 0 0; }
  .name em { font-style: italic; color: var(--accent); font-weight: 300; }
  .right { position: relative; }
  .orb { position: absolute; inset: -10% -30% -10% -20%; border-radius: 50%; filter: blur(48px); background: radial-gradient(closest-side at 60% 50%, var(--accent-glow), transparent 70%); }
  .portrait { position: absolute; right: 0; bottom: -64px; width: 400px; height: 560px; border-radius: 999px 999px 0 0; overflow: hidden; background: linear-gradient(180deg, var(--accent-soft), var(--bg-2)); border: 1px solid var(--hair); border-bottom: 0; }
  .portrait :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 12%; transform: scale(1.06) translateY(3%); }
</style>
