---
import Base from '@/layouts/Base.astro';
import FeaturedArticle from '@/components/FeaturedArticle.astro';
---
<Base title="Writing" description="Technical writing by Gati Varshney, starting with the GSoC 2026 final report on Medium.">
  <section class="wrap head">
    <p class="eyebrow" data-reveal>Index · Writing</p>
    <h1 class="display" data-split-words data-anim>Notes from<br /><em>the debugging.</em></h1>
    <p class="lede" data-reveal="0.1">Long-form write-ups of the work. More will appear here as they are published.</p>
  </section>
  <section class="wrap">
    <FeaturedArticle />
  </section>
</Base>
<style>
  .head { padding-top: clamp(130px, 18vh, 200px); padding-bottom: clamp(40px, 6vw, 72px); }
  .head h1 { font-size: clamp(52px, 8vw, 120px); margin: 20px 0 28px; }
  .head .lede { max-width: 640px; }
  .wlist { border-top: 1px solid var(--hair); margin-top: 16px; }
  .wrow { display: grid; grid-template-columns: 110px 1fr 180px; gap: 32px; padding: 30px 0; border-bottom: 1px solid var(--hair); align-items: baseline; transition: padding-left 0.5s var(--ease-out); }
  .wrow:hover { padding-left: 12px; }
  .d { font-size: 12.5px; color: var(--ink-2); }
  .title { display: block; font-size: clamp(24px, 2.4vw, 34px); letter-spacing: -0.015em; line-height: 1.15; margin-bottom: 8px; }
  .sub { display: block; color: var(--ink-2); font-size: 15.5px; }
  .r { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-2); text-align: right; }
  @media (max-width: 860px) { .wrow { grid-template-columns: 1fr; gap: 8px; } .r { text-align: left; } }
</style>
