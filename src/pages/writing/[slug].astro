---
import Base from '@/layouts/Base.astro';
import { writing } from '@/data/site';

export function getStaticPaths() {
  return writing.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
---
<Base title={p.title} description={p.subtitle} type="article">
  <article class="wrap post">
    <p class="eyebrow" data-reveal><a class="u" href="/writing/">Writing</a> · {p.tag} · {p.date}</p>
    <h1 class="display" data-split-words data-anim>{p.title}</h1>
    <p class="lede" data-reveal="0.1">{p.subtitle}</p>
    <div class="wip" data-reveal>
      <p class="eyebrow">Draft</p>
      <p>This piece is being written from the primary sources (pull requests, decision records, changelogs). It will appear here with its numbers and reproduction links.</p>
    </div>
  </article>
</Base>
<style>
  .post { padding-top: clamp(130px, 18vh, 200px); max-width: 860px; }
  h1 { font-size: clamp(40px, 5.6vw, 76px); margin: 20px 0 24px; line-height: 1.02; }
  .lede { max-width: 680px; }
  .wip { margin-top: 48px; padding: 24px 28px; border: 1px dashed var(--hair-strong); border-radius: var(--radius-lg); }
  .wip p:last-child { margin-top: 10px; color: var(--ink-2); }
</style>
