---
import Base from '@/layouts/Base.astro';
---
<Base title="Page not found" description="That page does not exist.">
  <Fragment slot="head"><meta name="robots" content="noindex" /></Fragment>
  <section class="wrap nf">
    <p class="eyebrow" data-reveal>404 — Not found</p>
    <h1 class="display" data-split-words data-anim>This page<br /><em>does not resolve.</em></h1>
    <p class="lede" data-reveal="0.1">Nothing lives at this address. The index can take you back.</p>
    <p class="ctas" data-reveal="0.15">
      <a class="btn fill" href="/" data-magnetic="0.3">Home</a>
      <a class="btn" href="/work/" data-magnetic="0.3">Work</a>
      <a class="btn" href="/projects/" data-magnetic="0.3">Projects</a>
      <a class="btn" href="/writing/" data-magnetic="0.3">Writing</a>
    </p>
  </section>
</Base>
<style>
  .nf { padding-top: clamp(140px, 22vh, 220px); min-height: 70svh; }
  h1 { font-size: clamp(48px, 8vw, 120px); margin: 20px 0 28px; }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
</style>
