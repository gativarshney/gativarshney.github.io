---
import Base from '@/layouts/Base.astro';
import Visual from '@/components/Visual.astro';
import ArchDiagram from '@/components/ArchDiagram.astro';
import CidxDemo from '@/components/CidxDemo.astro';
import { work } from '@/data/site';
import { caseStudies } from '@/data/casestudies';
import { diagrams } from '@/data/diagrams';

export function getStaticPaths() {
  return work.map((w) => ({ params: { slug: w.slug }, props: { w } }));
}
const { w } = Astro.props;
const cs = caseStudies[w.slug];
const diagram = diagrams[w.slug];
const idx = work.findIndex((x) => x.slug === w.slug);
const prev = work[(idx + work.length - 1) % work.length];
const next = work[(idx + 1) % work.length];
const sections = [
  { id: 'evidence', label: 'Claims and evidence' },
  { id: 'problem', label: 'The problem' },
  { id: 'how', label: 'How it works' },
  { id: 'decisions', label: 'Decisions' },
  { id: 'wrong', label: 'What went wrong' },
  { id: 'limits', label: 'Limitations' },
  { id: 'next', label: 'What I’d do next' },
];
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'TechArticle', headline: w.title, description: w.summary,
  dateModified: cs?.lastVerified, author: { '@id': 'https://gativarshney.github.io/#person' },
};
---
<Base title={w.title} description={w.summary} type="article">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonLd)} /></Fragment>
  <article class="wrap cs">
    <p class="eyebrow" data-reveal><a class="u" href="/work/">Work</a> · Case study · 0{idx + 1}</p>
    <h1 class="display" data-split-words data-anim>{w.title}</h1>
    <p class="lede" data-reveal="0.1">{w.summary}</p>
    <div class="tags" data-reveal="0.15">{w.status && <span class:list={['tag', w.status.tone]}>{w.status.label}</span>}{w.tags.map((t) => <span class="tag">{t}</span>)}<span class="tag">{w.period}</span></div>
    <p class="links" data-reveal="0.2">
      {w.links.slice(1).map((l) => <a class="btn" href={l.href} target="_blank" rel="noopener" data-magnetic="0.25">{l.label} <span class="arr">↗</span></a>)}
    </p>

    <div class="grid">
      <div class="ev" data-reveal-group="0.1">
        {w.evidence.map((e) => (<div><span class="stat">{e.value}</span><span class="lab">{e.label}</span></div>))}
      </div>
      <div data-reveal="0.1"><Visual kind={w.visual} /></div>
    </div>

    {diagram && (
      <section class="two archsec" id="architecture">
        <div><p class="eyebrow" data-reveal>Architecture</p><h2 class="display" data-reveal="0.05">The system, <em>at a glance.</em></h2></div>
        <ArchDiagram diagram={diagram} />
      </section>
    )}

    {w.slug === 'cidx' && (
      <section class="two archsec" id="try">
        <div><p class="eyebrow" data-reveal>Try it</p><h2 class="display" data-reveal="0.05">A real index, <em>in your browser.</em></h2></div>
        <div data-reveal="0.1"><CidxDemo /></div>
      </section>
    )}

    {cs && (
      <div class="body" data-snav-body>
        <section id="evidence">
          <p class="eyebrow" data-reveal>01 — Claims and evidence</p>
          <table class="evtable" data-reveal>
            <thead><tr><th>Claim</th><th>Measurement</th><th>Context</th><th>Verify</th></tr></thead>
            <tbody>
              {cs.evidence.map((r) => (
                <tr>
                  <td>{r.claim}</td>
                  <td class="mono v">{r.value}</td>
                  <td class="c">{r.context}</td>
                  <td class="l"><a class="u" href={r.source.href} target="_blank" rel="noopener">{r.source.label} ↗</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <section id="problem" class="two">
          <div><p class="eyebrow" data-reveal>02 — The problem</p></div>
          <div class="prose" data-reveal="0.05">{cs.problem.map((p) => <p>{p}</p>)}</div>
        </section>

        <section id="how" class="two">
          <div><p class="eyebrow" data-reveal>03 — How it works</p><h2 class="display" data-reveal="0.05">{cs.pipeline.title}</h2></div>
          <div data-reveal="0.1">
            <ol class="steps">{cs.pipeline.steps.map((s) => <li>{s}</li>)}</ol>
            {cs.pipeline.note && <p class="note mono">{cs.pipeline.note}</p>}
          </div>
        </section>

        <section id="decisions" class="two">
          <div><p class="eyebrow" data-reveal>04 — Decisions</p></div>
          <div class="blocks" data-reveal-group="0.08">
            {cs.decisions.map((d) => (<div class="block"><h3>{d.title}</h3><p>{d.body}</p></div>))}
          </div>
        </section>

        <section id="wrong" class="two">
          <div><p class="eyebrow" data-reveal>05 — What went wrong</p><h2 class="display" data-reveal="0.05">Stated <em>on purpose.</em></h2></div>
          <div class="blocks" data-reveal-group="0.08">
            {cs.wentWrong.map((d) => (<div class="block wrong"><h3>{d.title}</h3><p>{d.body}</p></div>))}
          </div>
        </section>

        <section id="limits" class="two">
          <div><p class="eyebrow" data-reveal>06 — Limitations</p></div>
          <ul class="limits" data-reveal-group="0.06">{cs.limitations.map((l) => <li>{l}</li>)}</ul>
        </section>

        <section id="next" class="two">
          <div><p class="eyebrow" data-reveal>07 — What I’d do next</p></div>
          <ul class="limits next" data-reveal-group="0.06">{cs.next.map((l) => <li>{l}</li>)}</ul>
        </section>

        <p class="verified mono" data-reveal>Last verified {cs.lastVerified} · numbers reported as measured, with their context and source</p>
      </div>
    )}

    {cs && (
      <nav class="snav" data-snav aria-label="Sections of this case study">
        <button class="cur mono" type="button" data-snav-toggle aria-expanded="false" aria-label="Show the sections of this case study">
          <span><span data-snav-n>01</span><span class="of"> / 0{sections.length}</span></span>
          <span data-snav-label>{sections[0].label}</span>
        </button>
        <ol>
          {sections.map((sec, i) => (
            <li><a href={`#${sec.id}`} data-snav-link={sec.id}><span class="t">{sec.label}</span><span class="n mono">0{i + 1}</span></a></li>
          ))}
        </ol>
        <span class="bar" aria-hidden="true"><i></i></span>
      </nav>
    )}

    <nav class="pn" aria-label="Other case studies" data-reveal>
      <a href={`/work/${prev.slug}/`} class="u">← {prev.title}</a>
      <a href={`/work/${next.slug}/`} class="u">{next.title} →</a>
    </nav>
  </article>
</Base>

<style>
  .cs { padding-top: clamp(130px, 18vh, 200px); }
  h1 { font-size: clamp(48px, 7.5vw, 112px); margin: 20px 0 28px; }
  .lede { max-width: 720px; margin-bottom: 24px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 26px; }
  .links { display: flex; flex-wrap: wrap; gap: 10px; }
  .grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 48px; align-items: center; margin-top: clamp(56px, 7vw, 96px); }
  .ev { display: grid; gap: 28px; }
  .ev .stat { font-size: clamp(40px, 4.4vw, 64px); }
  .ev .lab { display: block; margin-top: 8px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); }

  .body { margin-top: clamp(64px, 8vw, 120px); display: grid; gap: clamp(64px, 8vw, 112px); }
  .two { display: grid; grid-template-columns: 0.32fr 0.68fr; gap: 40px; align-items: start; }
  .archsec { margin-top: clamp(64px, 8vw, 120px); }
  .two > :global(*) { min-width: 0; }
  .two h2 { font-size: clamp(28px, 2.8vw, 40px); margin-top: 14px; line-height: 1.05; }
  .prose p { max-width: 720px; margin-bottom: 18px; font-size: 17.5px; color: var(--ink-2); }
  .prose p:first-child { color: var(--ink); }

  .evtable { width: 100%; border-collapse: collapse; margin-top: 18px; font-size: 15px; }
  .evtable th { text-align: left; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-2); font-weight: 500; padding: 10px 14px 10px 0; border-bottom: 1px solid var(--ink); }
  .evtable td { padding: 14px 14px 14px 0; border-bottom: 1px solid var(--hair); vertical-align: top; }
  .evtable td.v { font-size: 14px; white-space: nowrap; color: var(--ink); }
  .evtable td.c { color: var(--ink-2); font-size: 14px; }
  .evtable td.l { white-space: nowrap; font-size: 14px; color: var(--ink-2); }

  .steps { counter-reset: s; display: grid; gap: 14px; max-width: 760px; }
  .steps li { position: relative; padding-left: 44px; color: var(--ink-2); font-size: 16.5px; }
  .steps li::before { counter-increment: s; content: counter(s, decimal-leading-zero); position: absolute; left: 0; top: 4px; font-family: var(--font-mono); font-size: 12px; color: var(--accent); letter-spacing: 0.08em; }
  .note { margin-top: 22px; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); border-left: 2px solid var(--accent); padding-left: 14px; }

  .blocks { display: grid; gap: 0; border-top: 1px solid var(--hair); max-width: 800px; }
  .block { padding: 22px 0; border-bottom: 1px solid var(--hair); }
  .block h3 { font-size: 18px; font-weight: 500; margin-bottom: 8px; }
  .block p { color: var(--ink-2); font-size: 16px; }
  .block.wrong h3::before { content: '✕'; font-family: var(--font-mono); color: var(--warn); margin-right: 10px; font-size: 13px; }

  .limits { display: grid; gap: 12px; max-width: 800px; }
  .limits li { position: relative; padding-left: 22px; color: var(--ink-2); font-size: 16px; }
  .limits li::before { content: ''; position: absolute; left: 0; top: 11px; width: 8px; height: 1px; background: var(--ink-3); }
  .limits.next li::before { background: var(--accent); }

  .verified { font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); border-top: 1px solid var(--hair); padding-top: 16px; }
  .pn { display: flex; justify-content: space-between; gap: 24px; margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--hair); font-size: 15px; color: var(--ink-2); }

  /* sticky section progress: a rail in the right margin on wide screens, a pill at the bottom otherwise */
  .snav { position: fixed; z-index: 80; --sp: 0; opacity: 0; visibility: hidden; transition: opacity 0.4s var(--ease-out), transform 0.5s var(--ease-out), visibility 0s 0.4s; }
  .snav.is-on { opacity: 1; visibility: visible; transition: opacity 0.4s var(--ease-out), transform 0.5s var(--ease-out); }
  .snav .n { font-size: 10.5px; letter-spacing: 0.08em; }
  .snav a { color: var(--ink-3); transition: color 0.3s var(--ease-out); }
  .snav a:hover { color: var(--ink); }
  .snav a.is-on { color: var(--accent); }
  .bar i { display: block; width: 100%; height: 100%; }
  @media (min-width: 1200px) {
    .snav { right: 12px; top: 50%; transform: translate(8px, -50%); }
    .snav.is-on { transform: translate(0, -50%); }
    .cur { display: none; }
    .snav ol { display: grid; gap: 2px; padding-right: 12px; }
    .snav a { display: flex; align-items: center; justify-content: flex-end; gap: 10px; padding: 5px 0; }
    .snav .t { font-size: 12.5px; white-space: nowrap; padding: 4px 11px; border-radius: 999px; background: var(--bg); border: 1px solid var(--hair); color: var(--ink); opacity: 0; transform: translateX(8px); pointer-events: none; transition: opacity 0.3s var(--ease-out), transform 0.4s var(--ease-out); }
    .snav:hover .t, .snav:focus-within .t { opacity: 1; transform: none; }
    .snav a.is-on .t { border-color: color-mix(in oklch, var(--accent) 55%, transparent); color: var(--accent); }
    .bar { position: absolute; right: 0; top: 8px; bottom: 8px; width: 1px; background: var(--hair-strong); }
    .bar i { background: var(--accent); transform: scaleY(var(--sp)); transform-origin: top; }
  }
  @media (max-width: 1199.98px) {
    .snav { left: 50%; bottom: max(14px, env(safe-area-inset-bottom)); transform: translate(-50%, 14px); }
    .snav.is-on { transform: translate(-50%, 0); }
    .cur { position: relative; display: inline-flex; align-items: center; gap: 12px; height: 46px; padding: 0 20px 3px; border-radius: 999px; background: var(--ink); color: var(--bg); font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; white-space: nowrap; box-shadow: 0 14px 34px -12px oklch(0% 0 0 / 0.5); }
    .cur .of { opacity: 0.55; }
    .bar { position: absolute; left: 20px; right: 20px; bottom: 8px; height: 2px; border-radius: 2px; overflow: hidden; pointer-events: none; background: color-mix(in oklch, var(--bg) 26%, transparent); }
    .bar i { background: var(--bg); transform: scaleX(var(--sp)); transform-origin: left; }
    .snav ol { display: none; position: absolute; left: 50%; bottom: calc(100% + 10px); transform: translateX(-50%); width: max-content; min-width: 264px; padding: 8px; border-radius: 16px; background: var(--bg); border: 1px solid var(--hair-strong); box-shadow: 0 30px 60px -24px oklch(0% 0 0 / 0.5); }
    .snav.is-open ol { display: grid; }
    .snav a { display: flex; flex-direction: row-reverse; justify-content: flex-end; align-items: baseline; gap: 14px; padding: 11px 12px; border-radius: 10px; color: var(--ink-2); font-size: 15px; }
    .snav a.is-on { background: var(--bg-2); }
  }

  @media (max-width: 860px) {
    .grid, .two { grid-template-columns: 1fr; gap: 20px; }
    .evtable, .evtable thead, .evtable tbody, .evtable tr, .evtable th, .evtable td { display: block; }
    .evtable thead { position: absolute; left: -9999px; }
    .evtable tr { padding: 14px 0; border-bottom: 1px solid var(--hair); }
    .evtable td { border: 0; padding: 3px 0; white-space: normal !important; }
    .evtable td:first-child { font-weight: 500; }
  }
</style>
