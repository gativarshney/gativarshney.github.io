---
import CaseStudyPage from '@/components/CaseStudyPage.astro';
import { workStudies } from '@/data/site';

export function getStaticPaths() {
  return workStudies.map((w) => ({ params: { slug: w.slug }, props: { w } }));
}
const { w } = Astro.props;
---
<CaseStudyPage w={w} list={workStudies} section={{ label: 'Work', href: '/work/' }} />
