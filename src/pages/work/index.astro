---
import Base from '@/layouts/Base.astro';
import Milestone from '@/components/Milestone.astro';
import { milestones, workStudies } from '@/data/site';

// newest role first
const roles = [...milestones].reverse();
---
<Base title="Work" image="/og/work.png" description="Work by Gati Varshney: a software engineering internship at Quin Que in Japan, Google Summer of Code 2026 at OpenPrinting, and ten months of open-source contribution, each with its evidence.">
  <section class="wrap head">
    <p class="eyebrow" data-reveal>Index · Work</p>
    <h1 class="display" data-split-words data-anim>Built with<br /><em>other people.</em></h1>
    <p class="lede" data-reveal="0.1">An internship in Japan, Google Summer of Code, and ten months of open source at OpenPrinting: work that went through someone else’s review before it shipped. What I built on my own is under <a class="u" href="/projects/">Projects</a>.</p>
  </section>

  <section class="wrap">
    <p class="eyebrow" data-reveal>Roles · newest first</p>
    <div class="entries">
      {roles.map((m, i) => <Milestone entry={m} num={`0${i + 1}`} />)}
      <hr class="hr" data-line />
    </div>
  </section>

  <section class="wrap section">
    <div class="shead">
      <div>
        <p class="eyebrow" data-reveal>Case studies</p>
        <h2 class="display" data-split-words data-anim>The same work,<br /><em>taken apart.</em></h2>
      </div>
      <p data-reveal="0.15">Two pieces of that work written up in full: the problem, how it works, what went wrong, and where to check every number.</p>
    </div>
    <ul class="studies" data-reveal-group="0.08">
      {workStudies.map((w, i) => (
        <li><a href={w.href} data-cursor="Open"><span class="mono n">0{i + 1}</span><span class="t display">{w.title}</span><span class="d"><span class="k mono">{w.kicker}</span>{w.summary}</span><span class="arr display">→</span></a></li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .head { padding-top: clamp(130px, 18vh, 200px); padding-bottom: clamp(40px, 6vw, 72px); }
  .head h1 { font-size: clamp(48px, 7.6vw, 112px); margin: 20px 0 28px; }
  .head .lede { max-width: 700px; }
  .entries { margin-top: 8px; }
  .studies { border-top: 1px solid var(--hair); }
  .studies a { display: grid; grid-template-columns: 56px 0.5fr 1fr auto; gap: 24px; align-items: baseline; padding: 30px 0; border-bottom: 1px solid var(--hair); transition: padding-left 0.5s var(--ease-out); }
  .studies a:hover { padding-left: 14px; }
  .studies .n { font-size: 12px; color: var(--ink-2); }
  .studies .t { font-size: clamp(26px, 2.8vw, 40px); letter-spacing: -0.02em; line-height: 1.05; transition: color 0.3s; }
  .studies a:hover .t { color: var(--accent); }
  .studies .d { color: var(--ink-2); font-size: 15.5px; max-width: 560px; }
  .studies .k { display: block; margin-bottom: 8px; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); }
  .studies .arr { font-size: 32px; font-weight: 300; color: var(--ink-3); transition: transform 0.5s var(--ease-out), color 0.3s; }
  .studies a:hover .arr { transform: translateX(8px); color: var(--accent); }
  @media (max-width: 860px) {
    .studies a { grid-template-columns: 1fr auto; gap: 8px 16px; padding: 22px 0; }
    .studies .n { display: none; }
    .studies .d { grid-column: 1 / -1; }
  }
</style>
