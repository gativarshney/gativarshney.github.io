---
import Base from '@/layouts/Base.astro';
import Milestone from '@/components/Milestone.astro';
import FeaturedArticle from '@/components/FeaturedArticle.astro';
import Timeline from '@/components/Timeline.astro';
import Portrait from '@/components/Portrait.astro';
import LeetCode from '@/components/LeetCode.astro';
import Recommendation from '@/components/Recommendation.astro';
import { Image } from 'astro:assets';
import pvWork from '@/assets/previews/page-work.jpg';
import pvOpen from '@/assets/previews/page-open-source.jpg';
import pvWriting from '@/assets/previews/page-writing.jpg';
import pvAbout from '@/assets/previews/page-about.jpg';
const previews = { work: pvWork, 'open-source': pvOpen, writing: pvWriting, about: pvAbout };
import { site, milestones, work, record } from '@/data/site';

const cidx = work.find((w) => w.slug === 'cidx')!;
const repoinsight = work.find((w) => w.slug === 'repoinsight')!;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    '@id': `${site.url}/#person`,
    name: site.name,
    url: site.url,
    email: `mailto:${site.email}`,
    jobTitle: 'Software engineering student',
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'JSS Academy of Technical Education, Noida' },
    sameAs: [site.links.github, site.links.linkedin, site.links.leetcode, site.links.medium],
    knowsAbout: ['Developer tools', 'Code indexing', 'Model Context Protocol', 'Recommendation systems', 'Python', 'TypeScript'],
  },
};
---
<Base>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <!-- HERO ----------------------------------------------------------- -->
  <section class="hero" data-hero>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" data-hero-eyebrow data-anim><span class="dot"></span>Final-year CS&nbsp;student · GSoC&nbsp;2026 at&nbsp;OpenPrinting · Open&nbsp;to&nbsp;relocation</p>
        <h1 class="display" data-hero-title data-anim>Software that<br /><em>proves itself.</em></h1>
        <p class="lede" data-hero-lede data-anim>I’m Gati Varshney, a final-year CS student and <b>Google Summer of Code 2026</b> contributor at <b>OpenPrinting, The Linux Foundation</b>.</p>
        <div class="ctas" data-hero-cta>
          <a class="btn fill" href="#journey" data-magnetic="0.3" data-anim>The journey <span class="arr">↓</span></a>
          <a class="btn ghost" href={site.links.github} target="_blank" rel="noopener" data-magnetic="0.3" data-anim>GitHub <span class="arr">↗</span></a>
          <a class="btn ghost" href={site.links.linkedin} target="_blank" rel="noopener" data-magnetic="0.3" data-anim>LinkedIn <span class="arr">↗</span></a>
        </div>
      </div>

      <Portrait badge="GSoC ’26 · Linux Foundation" />
    </div>

    <div class="wrap">
      <ul class="strip" data-hero-strip>
        {record.map((r) => (
          <li data-anim>
            <span class="k">{r.k}</span>
            <span class="v">{r.v}</span>
            <span class="m">{r.m}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PRINCIPLE ------------------------------------------------------ -->
  <section class="section wrap">
    <p class="eyebrow" data-reveal>01 — Principle</p>
    <p class="manifesto display" data-split-words data-anim>Most software is trusted because it <em>looks</em> right. I’d rather build things that can be <em>checked</em>: numbers with the commands that produced them, decision records, evaluation harnesses that fail when a claim drifts, and limitation sections nobody asked for.</p>
  </section>

  <!-- JOURNEY -------------------------------------------------------- -->
  <section class="section wrap" id="journey">
    <div class="shead">
      <div>
        <p class="eyebrow" data-reveal>02 — Professional journey</p>
        <h2 class="display" data-split-words data-anim>From first commit<br /><em>to production.</em></h2>
      </div>
      <p data-reveal="0.15">Open source first, then Google Summer of Code, then industry. Each stop with its evidence and the pages where you can check it.</p>
    </div>

    <Timeline>
      {milestones.map((m, i) => <Milestone entry={m} num={`0${i + 1}`} />)}
      <hr class="hr" data-line />
    </Timeline>
    <p class="all more" data-reveal><a class="btn fill" href="/open-source/" data-magnetic="0.3">The open-source story <span class="arr">→</span></a><a class="btn" href="/about/" data-magnetic="0.3">About me <span class="arr">→</span></a></p>
  </section>

  <!-- RECOMMENDATION ------------------------------------------------- -->
  <Recommendation />

  <!-- PROJECT -------------------------------------------------------- -->
  <section class="section wrap" id="project">
    <div class="shead">
      <div>
        <p class="eyebrow" data-reveal>03 — Selected projects</p>
        <h2 class="display" data-split-words data-anim>Built, measured,<br /><em>documented.</em></h2>
      </div>
      <p data-reveal="0.15">Two tools built on my own time: a code index for AI coding agents, published on PyPI, and a web app that tells contributors what to expect from a repository. Both show the evidence behind every number.</p>
    </div>
    <div class="entries">
      <Milestone entry={cidx} num="04" />
      <Milestone entry={repoinsight} num="05" />
      <hr class="hr" data-line />
    </div>
    <p class="all"><a class="btn fill" href="/work/" data-magnetic="0.3" data-reveal>All projects <span class="arr">→</span></a></p>
  </section>

  <!-- COMPETITIVE PROGRAMMING --------------------------------------- -->
  <section class="section wrap" id="leetcode">
    <div class="shead">
      <div>
        <p class="eyebrow" data-reveal>04 — Competitive programming</p>
        <h2 class="display" data-split-words data-anim>Hard problems,<br /><em>for their own sake.</em></h2>
      </div>
      <p data-reveal="0.15">Contest rating and every badge earned on LeetCode, pulled from the profile.</p>
    </div>
    <LeetCode wide />
  </section>

  <!-- WRITING -------------------------------------------------------- -->
  <section class="section wrap">
    <div class="shead">
      <div>
        <p class="eyebrow" data-reveal>05 — Writing</p>
        <h2 class="display" data-split-words data-anim>Notes from<br /><em>the debugging.</em></h2>
      </div>
      <p data-reveal="0.15">Long-form write-ups of the work, starting with the GSoC 2026 final report.</p>
    </div>
    <FeaturedArticle />
    <p class="all" data-reveal><a class="btn" href="/writing/" data-magnetic="0.3">All writing <span class="arr">→</span></a></p>
  </section>

  <!-- EXPLORE -------------------------------------------------------- -->
  <section class="section wrap" id="explore">
    <div class="shead">
      <div>
        <p class="eyebrow" data-reveal>06 — Explore</p>
        <h2 class="display" data-split-words data-anim>The rest<br /><em>of the site.</em></h2>
      </div>
      <p data-reveal="0.15">Four pages, each with the evidence behind what this one summarises.</p>
    </div>
    <ul class="explore" data-reveal-group="0.08">
      <li><a href="/work/" data-cursor="Open" data-preview="work"><span class="mono n">01</span><span class="t display">Work</span><span class="d">Projects with their evidence: cidx, RepoInsight, the GSoC printer recommendations, and the OpenPrinting site search. Claims, decisions, and what went wrong.</span><span class="arr display">→</span></a></li>
      <li><a href="/open-source/" data-cursor="Open" data-preview="open-source"><span class="mono n">02</span><span class="t display">Open Source</span><span class="d">The live OpenPrinting Hall of Fame, every pull request grouped by what it built, and both certificates.</span><span class="arr display">→</span></a></li>
      <li><a href="/writing/" data-cursor="Open" data-preview="writing"><span class="mono n">03</span><span class="t display">Writing</span><span class="d">Long-form write-ups, starting with the GSoC 2026 final report.</span><span class="arr display">→</span></a></li>
      <li><a href="/about/" data-cursor="Open" data-preview="about"><span class="mono n">04</span><span class="t display">About</span><span class="d">Education, experience, competitive programming, certificates, and the résumé.</span><span class="arr display">→</span></a></li>
    </ul>
    <div class="hp" data-hover-preview aria-hidden="true">
      {Object.entries(previews).map(([k, img]) => (
        <div class="hp-img" data-preview-img={k}><Image src={img} alt="" widths={[640, 960]} sizes="360px" loading="lazy" /></div>
      ))}
    </div>
  </section>

  <!-- CONTACT -------------------------------------------------------- -->
  <section class="section wrap contact" id="contact">
    <div>
      <p class="eyebrow" data-reveal>07 — Start a conversation</p>
      <h2 class="display" data-split-words data-anim>Start a<br /><em>conversation.</em></h2>
      <p class="lede" data-reveal="0.1">Have an opportunity, an interesting idea, or want to talk about engineering? I’d love to hear from you.</p>
      <p class="ctas contact-ctas" data-reveal="0.15">
        <a class="btn fill" href={`mailto:${site.email}?subject=Hello%20Gati`} data-magnetic="0.3">Get in touch via email <span class="arr">↗</span></a>
        <a class="btn" href={site.links.linkedin} target="_blank" rel="noopener" data-magnetic="0.3">LinkedIn <span class="arr">↗</span></a>
      </p>
      <p class="email-line" data-reveal="0.2">
        <a class="email display" href={`mailto:${site.email}`} data-copy={site.email} data-cursor="Copy" data-magnetic="0.15">{site.email}</a>
        <span class="note mono" data-copy-note>click to copy</span>
      </p>
    </div>
    <dl class="meta" data-reveal-group="0.08">
      <div><dt class="eyebrow">Based</dt><dd>India (IST) · open to relocation, anywhere</dd></div>
      <div><dt class="eyebrow">Status</dt><dd>Graduating 2027 · open to internships &amp; new-grad roles</dd></div>
      <div><dt class="eyebrow">Elsewhere</dt><dd><a class="u" href={site.links.github} target="_blank" rel="noopener">GitHub</a> · <a class="u" href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn</a> · <a class="u" href={site.links.leetcode} target="_blank" rel="noopener">LeetCode</a></dd></div>
    </dl>
  </section>
</Base>

<style>
  /* principle */
  .manifesto { font-size: clamp(26px, 3.3vw, 46px); line-height: 1.22; font-weight: 300; letter-spacing: -0.015em; max-width: 1080px; margin-top: 28px; }

  .entries { margin-top: 8px; }
  .all { margin-top: 40px; display: flex; flex-wrap: wrap; gap: 12px; }

  /* explore index */
  .explore { border-top: 1px solid var(--hair); }
  .explore a { display: grid; grid-template-columns: 56px 0.42fr 1fr auto; gap: 24px; align-items: baseline; padding: 30px 0; border-bottom: 1px solid var(--hair); transition: padding-left 0.5s var(--ease-out), background-color 0.4s; }
  .explore a:hover { padding-left: 14px; }
  .explore .n { font-size: 12px; color: var(--ink-3); }
  .explore .t { font-size: clamp(30px, 3.4vw, 48px); letter-spacing: -0.02em; line-height: 1; transition: color 0.3s; }
  .explore a:hover .t { color: var(--accent); }
  .explore .d { color: var(--ink-2); font-size: 15.5px; max-width: 520px; }
  .explore .arr { font-size: 32px; font-weight: 300; color: var(--ink-3); transition: transform 0.5s var(--ease-out), color 0.3s; }
  .explore a:hover .arr { transform: translateX(8px); color: var(--accent); }
  /* floating page preview that trails the cursor over the explore rows */
  .hp { position: fixed; left: 0; top: 0; z-index: 60; width: 360px; aspect-ratio: 16 / 10; margin: -112px 0 0 28px; border-radius: 12px; overflow: hidden; pointer-events: none; opacity: 0; transform: scale(0.9); border: 1px solid var(--hair-strong); box-shadow: 0 30px 70px -30px oklch(0% 0 0 / 0.55), 0 1px 0 0 oklch(100% 0 0 / 0.5) inset; background: var(--bg-2); will-change: transform, opacity; }
  .hp-img { position: absolute; inset: 0; opacity: 0; transition: opacity 0.35s var(--ease-out); }
  .hp-img.is-on { opacity: 1; }
  .hp-img :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  @media (pointer: coarse), (max-width: 860px) { .hp { display: none; } }

  /* writing */
  .wlist { border-top: 1px solid var(--hair); }
  .wrow { display: grid; grid-template-columns: 110px 1fr 180px; gap: 32px; padding: 28px 0; border-bottom: 1px solid var(--hair); align-items: baseline; transition: padding-left 0.5s var(--ease-out); }
  .wrow:hover { padding-left: 12px; }
  .wrow .d { font-size: 12.5px; color: var(--ink-2); }
  .wrow .title { display: block; font-size: clamp(22px, 2.2vw, 30px); letter-spacing: -0.015em; line-height: 1.15; margin-bottom: 6px; }
  .wrow .sub { display: block; color: var(--ink-2); font-size: 15.5px; }
  .wrow .r { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-2); text-align: right; }

  /* contact */
  .contact { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 64px; align-items: end; }
  .contact h2 { font-size: clamp(48px, 7vw, 104px); margin: 20px 0 28px; font-weight: 300; }
  .contact .lede { max-width: 560px; margin-bottom: 28px; }
  .contact-ctas { margin-bottom: 40px; }
  .email-line { margin-top: 8px; }
  .email { font-size: clamp(20px, 2vw, 26px); border-bottom: 1px solid var(--hair-strong); padding-bottom: 4px; display: inline-block; transition: border-color 0.3s, color 0.3s; }
  .email:hover { color: var(--accent); border-color: var(--accent); }
  .note { display: block; margin-top: 12px; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3); transition: color 0.3s; }
  .note.is-on { color: var(--accent); }
  .meta { display: grid; grid-template-columns: 1fr 1fr; gap: 28px 32px; }
  .meta div:last-child { grid-column: 1 / -1; }
  .meta dt { margin-bottom: 8px; }
  .meta dd { font-size: 16px; }

  @media (max-width: 860px) {
    .strip { grid-template-columns: 1fr; }
    .strip li { border-right: 0; border-bottom: 1px solid var(--hair); padding-left: 0 !important; }
    .wrow { grid-template-columns: 1fr; gap: 8px; }
    .wrow .r { text-align: left; }
    .explore a { grid-template-columns: 1fr auto; gap: 6px 16px; padding: 22px 0; }
    .explore .n { display: none; }
    .explore .d { grid-column: 1 / -1; }
    .contact { grid-template-columns: 1fr; gap: 40px; }
  }
</style>
