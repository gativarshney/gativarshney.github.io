---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '@/data/site';
import badges from '@/data/leetcode-badges.json';

const icons = import.meta.glob<{ default: ImageMetadata }>('/src/assets/leetcode/*.png', { eager: true });
const icon = (slug: string) => icons[`/src/assets/leetcode/${slug}.png`]?.default;
interface Props { wide?: boolean }
const { wide = false } = Astro.props;
const knight = icon('knight');
const rest = badges.filter((b) => b.slug !== 'knight').sort((a, b) => b.date.localeCompare(a.date));
const fmt = (d: string) => new Date(d + 'T00:00:00Z').toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<div class:list={['lc', { wide }]}>
  <a class="knight" href={site.links.leetcode} target="_blank" rel="noopener" data-cursor="Open" data-tilt="4">
    <span class="kb"><Image src={knight} alt="LeetCode Knight badge" width={120} height={120} /></span>
    <span class="kt">
      <span class="eyebrow">LeetCode · as of Sep 2026</span>
      <span class="display kn">Knight</span>
      <span class="km">Contest rating 1925 · top 3.98% of contest participants · 750+ problems solved</span>
    </span>
    <span class="arr display">→</span>
  </a>
  <ul class="badges" data-reveal-group="0.05">
    {rest.map((b) => (
      <li title={`${b.name} · earned ${fmt(b.date)}`}>
        <span class="bb"><Image src={icon(b.slug)!} alt={b.name} width={144} height={144} /></span>
        <span class="bn">{b.name}</span>
        <span class="bd mono">{fmt(b.date)}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .lc { margin-top: 18px; max-width: 860px; }
  .lc.wide { max-width: none; margin-top: 0; }
  .lc.wide .badges { grid-template-columns: repeat(8, 1fr); }
  .knight { display: grid; grid-template-columns: auto 1fr auto; gap: 22px; align-items: center; padding: 22px 26px; border: 1px solid var(--hair); border-radius: 16px; background: var(--bg-2); transform: perspective(1000px); transition: border-color 0.4s, box-shadow 0.6s var(--ease-out); box-shadow: 0 1px 0 0 oklch(100% 0 0 / 0.5) inset; }
  .knight:hover { border-color: var(--hair-strong); box-shadow: 0 1px 0 0 oklch(100% 0 0 / 0.5) inset, 0 24px 48px -28px oklch(0% 0 0 / 0.4); }
  .kb { width: 84px; height: 84px; display: grid; place-items: center; border-radius: 50%; background: radial-gradient(circle at 35% 30%, oklch(100% 0 0 / 0.9), transparent 60%), oklch(95% 0.05 75); border: 1px solid oklch(78% 0.14 70 / 0.6); }
  .kb :global(img) { width: 60px; height: 60px; filter: drop-shadow(0 6px 10px oklch(0% 0 0 / 0.25)); }
  .kt { display: grid; gap: 4px; }
  .kn { font-size: clamp(30px, 3vw, 40px); line-height: 1; letter-spacing: -0.02em; }
  .km { font-size: 14.5px; color: var(--ink-2); }
  .knight .arr { font-size: 30px; font-weight: 300; color: var(--ink-3); transition: transform 0.5s var(--ease-out), color 0.3s; }
  .knight:hover .arr { transform: translateX(8px); color: var(--accent); }
  .badges { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 14px; }
  .badges li { display: grid; justify-items: center; gap: 6px; padding: 18px 10px 14px; border: 1px solid var(--hair); border-radius: 14px; background: var(--bg); text-align: center; transition: transform 0.5s var(--ease-out), border-color 0.4s, background-color 0.4s; }
  .badges li:hover { transform: translateY(-4px); border-color: var(--hair-strong); background: var(--bg-2); }
  .bb :global(img) { width: 72px; height: 72px; filter: drop-shadow(0 8px 12px oklch(0% 0 0 / 0.22)); transition: transform 0.6s var(--ease-out); }
  .badges li:hover .bb :global(img) { transform: scale(1.08) rotate(-3deg); }
  .bn { font-size: 13px; font-weight: 500; line-height: 1.3; }
  .bd { font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
  @media (max-width: 860px) {
    .knight { grid-template-columns: auto 1fr; padding: 18px; }
    .knight .arr { display: none; }
    .badges, .lc.wide .badges { grid-template-columns: repeat(2, 1fr); }
  }
</style>
