---
import { Image } from 'astro:assets';
import Preview from '@/components/Preview.astro';
import Certificate from '@/components/Certificate.astro';
import Logo from '@/components/Logo.astro';
import { site } from '@/data/site';
import opLogo from '@/assets/logos/openprinting.png';
import gsocLogo from '@/assets/logos/gsoc.svg';
import qqLogo from '@/assets/logos/quinque.png';
import lfLogo from '@/assets/logos/linuxfoundation.png';
import gsocCert from '@/assets/certs/gsoc-2026.jpg';
import cidxSite from '@/assets/previews/cidx-site.jpg';
import mediumSnap from '@/assets/writing/gsoc-report-cover.png';
import gsocSnap from '@/assets/previews/gsoc-project.png';
import searchSnap from '@/assets/previews/openprinting-search.jpg';
import riHome from '@/assets/previews/repoinsight-home.jpg';

interface Props { kind: 'cidx' | 'printers' | 'openprinting' | 'gsoc' | 'quinque' | 'search' | 'repoinsight' }
const { kind } = Astro.props;
---
{kind === 'openprinting' && (
  <>
    <div class="logo-row">
      <Logo src={opLogo} alt="OpenPrinting" tone="op" size={60} />
      <Logo src={lfLogo} alt="The Linux Foundation" tone="lf" size={60} />
      <div><p class="lname">OpenPrinting · The Linux Foundation</p><p class="lsub mono">the search I built, live on the production site</p></div>
    </div>
    <Preview url={site.links.openprintingSite} title="The search overlay on openprinting.github.io" image={searchSnap} alt="OpenPrinting search overlay open over the homepage, with OpenPrinting and Foomatic Lookup Site scopes and a Cmd/Ctrl+K shortcut" ratio="16 / 8" label="openprinting.github.io · Cmd/Ctrl + K" />
  </>
)}
{kind === 'gsoc' && (
  <>
    <div class="logo-row gsoc-row">
      <img src={gsocLogo.src} alt="Google Summer of Code" width="220" height="28" class="gsoc" />
      <span class="sep" aria-hidden="true"></span>
      <Logo src={opLogo} alt="OpenPrinting" tone="op" size={48} />
      <Logo src={lfLogo} alt="The Linux Foundation" tone="lf" size={48} />
      <div><p class="lname">OpenPrinting</p><p class="lsub mono">sponsored by The Linux Foundation</p></div>
    </div>
    <Preview url={site.links.gsocProject} title="Project page on summerofcode.withgoogle.com" image={gsocSnap} alt="Google Summer of Code project page: AI-Driven Printer Compatibility & Recommendation Portal" ratio="16 / 9" />
    <Certificate src={gsocCert} alt="Google Summer of Code 2026 completion certificate for Gati Varshney, The Linux Foundation, May 25 to August 24, 2026" title="GSoC 2026 certificate" meta="Signed by the program manager, Google" compact />
  </>
)}
{kind === 'quinque' && (
  <>
    <div class="logo-row">
      <Logo src={qqLogo} alt="Quin Que" tone="qq" size={60} />
      <div><p class="lname">Quin Que · Kobe, Japan</p><p class="lsub mono">international internship · remote · software engineer intern</p></div>
    </div>
    <div class="panel qq" data-tilt="3">
      <p class="eyebrow">Rapilogi</p>
      <p class="qq-mark display">Warehouse reception<br /><em>management.</em></p>
      <p class="qq-sub mono">software engineer intern · remote · kobe, japan</p>
      <p class="foot">A Japanese company · private company work · public outline only.</p>
    </div>
  </>
)}
{kind === 'cidx' && (
  <>
    <Preview url={site.links.cidxSite} title="The cidx website, live" live gate image={cidxSite} alt="The cidx website: a local code index for AI coding agents" ratio="16 / 10" />
    <a class="panel pypi" href={site.links.cidxPypi} target="_blank" rel="noopener" data-cursor="Open" data-tilt="2">
      <div>
        <p class="eyebrow">Install from PyPI</p>
        <pre>pip install --pre cidx</pre>
      </div>
      <p class="pypi-meta mono">pypi.org/project/cidx · alpha · Python 3.11+ · Apache-2.0 ↗</p>
    </a>
  </>
)}
{kind === 'repoinsight' && (
  <Preview url={site.links.repoinsightApp} title="RepoInsight, live" live gate image={riHome} alt="RepoInsight home page: Know a repository before your first pull request, with a field for a GitHub repository and a 3D skyline of commit activity" ratio="16 / 10" />
)}
{kind === 'search' && (
  <Preview url={site.links.openprintingSite} title="The OpenPrinting website, live" live gate image={searchSnap} alt="OpenPrinting search overlay open over the homepage, with OpenPrinting and Foomatic Lookup Site scopes and a Cmd/Ctrl+K shortcut" ratio="16 / 8" label="openprinting.github.io · Cmd/Ctrl + K" />
)}
{kind === 'printers' && (
  <Preview url={site.links.gsocReport} title="GSoC 2026 final report on Medium" image={mediumSnap} alt="Medium article: GSoC 2026 Final Report" ratio="16 / 10" />
)}

<style>
  .logo-row { display: flex; align-items: center; gap: 16px; }
  .logo { width: 56px; height: 56px; border-radius: 12px; border: 1px solid var(--hair); background: #fff; padding: 4px; object-fit: contain; }
  .gsoc { height: 26px; width: auto; padding: 10px 14px; border-radius: 999px; background: oklch(98% 0.01 75); border: 1px solid oklch(78% 0.14 70 / 0.5); box-sizing: content-box; }
  .gsoc-row { flex-wrap: wrap; gap: 12px 14px; }
  .sep { width: 1px; height: 28px; background: var(--hair); }
  .logo.sm { width: 40px; height: 40px; border-radius: 9px; }
  .pypi { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; padding: 18px 20px; }
  .pypi pre { font-size: 15px; margin-top: 10px; }
  .pypi-meta { font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); text-align: right; }
  .pypi:hover .pypi-meta { color: var(--accent); }
  @media (max-width: 600px) { .pypi { flex-direction: column; align-items: flex-start; } .pypi-meta { text-align: left; } }
  :global(:root[data-theme='dark']) .gsoc { background: oklch(97% 0.01 75); }
  .lname { font-weight: 500; font-size: 15px; }
  .lsub { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); margin-top: 2px; }
  .qq { min-height: 260px; display: flex; flex-direction: column; justify-content: space-between; }
  .qq-mark { font-size: clamp(34px, 3.4vw, 48px); font-weight: 300; letter-spacing: -0.02em; line-height: 1.02; margin: 18px 0 12px; }
  .qq { min-height: 240px; }
  .qq-sub { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-2); }
</style>
