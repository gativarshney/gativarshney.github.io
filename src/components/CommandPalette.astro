---
import { site, work } from '@/data/site';

type Item = { label: string; hint: string; href?: string; action?: 'theme' | 'copy-email'; keys?: string; external?: boolean };
const host = (u: string) => new URL(u).hostname.replace(/^www\./, '');
const ext = (label: string, href: string, keys = ''): Item => ({ label, href, hint: `${host(href)} ↗`, keys, external: true });

const groups: { label: string; items: Item[] }[] = [
  {
    label: 'Pages',
    items: [
      { label: 'Home', href: '/', hint: 'Page', keys: 'start index' },
      { label: 'Work', href: '/work/', hint: 'Page', keys: 'projects case studies' },
      { label: 'Open Source', href: '/open-source/', hint: 'Page', keys: 'openprinting linux foundation pull requests hall of fame gsoc' },
      { label: 'Writing', href: '/writing/', hint: 'Page', keys: 'articles blog medium report' },
      { label: 'About', href: '/about/', hint: 'Page', keys: 'education experience certificates bio' },
    ],
  },
  {
    label: 'Case studies',
    items: [
      ...work.map((w) => ({ label: w.title, href: `/work/${w.slug}/`, hint: 'Case study', keys: `${w.tags.join(' ')} ${w.kicker}` })),
      { label: 'Try cidx in the browser', href: '/work/cidx/#try', hint: 'Live demo', keys: 'cidx demo playground search index mcp tools' },
    ],
  },
  {
    label: 'On the home page',
    items: [
      { label: 'Professional journey', href: '/#journey', hint: 'Section', keys: 'timeline experience internship quin que gsoc openprinting' },
      { label: 'Mentor’s recommendation', href: '/#recommendation', hint: 'Section', keys: 'testimonial recommendation mentor rudra google linkedin reference' },
      { label: 'Competitive programming', href: '/#leetcode', hint: 'Section', keys: 'leetcode knight badges contest rating' },
      { label: 'Start a conversation', href: '/#contact', hint: 'Section', keys: 'contact hire email reach' },
    ],
  },
  {
    label: 'Actions',
    items: [
      { label: 'Switch colour theme', action: 'theme', hint: 'Action', keys: 'dark light mode toggle appearance' },
      { label: 'Copy email address', action: 'copy-email', hint: 'Action', keys: 'contact mail gmail' },
      { label: 'Open résumé (PDF)', href: site.links.resume, hint: 'PDF ↗', keys: 'resume cv download', external: true },
    ],
  },
  {
    label: 'Elsewhere',
    items: [
      ext('GitHub', site.links.github, 'code repositories profile'),
      ext('LinkedIn', site.links.linkedin, 'profile connect'),
      ext('LeetCode', site.links.leetcode, 'knight contest problems'),
      ext('Medium', site.links.medium, 'articles writing blog'),
      ext('GSoC 2026 final report', site.links.gsocReport, 'google summer of code article printer recommendations'),
      ext('cidx on GitHub', site.links.cidxRepo, 'repository source code index'),
      ext('cidx on PyPI', site.links.cidxPypi, 'package pip install'),
      ext('OpenPrinting Hall of Fame', site.links.hallOfFame, 'contributors linux foundation'),
    ],
  },
];
---
<dialog class="cmdk" data-cmdk aria-label="Command palette">
  <div class="box">
    <div class="top">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.8-3.8"/></svg>
      <input type="text" data-cmdk-input placeholder="Jump to a page, project or link" autocomplete="off" autocapitalize="off" spellcheck="false" role="combobox" aria-label="Search pages, projects and links" aria-expanded="true" aria-controls="cmdk-list" aria-autocomplete="list" />
      <button type="button" class="esc mono" data-cmdk-close aria-label="Close command palette">esc</button>
    </div>
    <div class="list" id="cmdk-list" role="listbox" aria-label="Results" data-lenis-prevent>
      {groups.map((g) => (
        <div class="grp" data-cmdk-group>
          <p class="gl mono">{g.label}</p>
          {g.items.map((it) => it.href ? (
            <a class="it" role="option" aria-selected="false" href={it.href} target={it.external ? '_blank' : undefined} rel={it.external ? 'noopener' : undefined} data-cmdk-item data-keys={`${it.label} ${it.keys ?? ''}`.toLowerCase()}>
              <span class="l">{it.label}</span><span class="h mono">{it.hint}</span>
            </a>
          ) : (
            <button class="it" type="button" role="option" aria-selected="false" data-cmdk-item data-cmdk-action={it.action} data-email={it.action === 'copy-email' ? site.email : undefined} data-keys={`${it.label} ${it.keys ?? ''}`.toLowerCase()}>
              <span class="l">{it.label}</span><span class="h mono">{it.hint}</span>
            </button>
          ))}
        </div>
      ))}
      <p class="empty" data-cmdk-empty hidden>Nothing matches. Try “work”, “résumé” or “github”.</p>
    </div>
    <div class="foot mono" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
    </div>
  </div>
</dialog>

<style>
  .cmdk { border: 0; padding: 0; background: transparent; color: var(--ink); width: min(640px, calc(100vw - 32px)); max-width: none; max-height: none; margin: 14vh auto 0; overflow: visible; }
  .cmdk::backdrop { background: color-mix(in oklch, var(--bg) 72%, transparent); backdrop-filter: blur(14px) saturate(1.2); -webkit-backdrop-filter: blur(14px) saturate(1.2); }
  .box { border: 1px solid var(--hair-strong); border-radius: 16px; background: var(--bg); overflow: hidden; box-shadow: 0 1px 0 0 oklch(100% 0 0 / 0.5) inset, 0 40px 100px -30px oklch(0% 0 0 / 0.5); }
  .top { display: flex; align-items: center; gap: 12px; padding: 16px 18px; border-bottom: 1px solid var(--hair); color: var(--ink-2); }
  .top input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font: inherit; font-size: 17px; color: var(--ink); }
  .top input::placeholder { color: var(--ink-2); }
  .esc, kbd { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; border: 1px solid var(--hair-strong); border-radius: 6px; padding: 3px 7px; color: var(--ink-2); }
  .esc:hover { color: var(--ink); border-color: var(--ink); }
  .list { max-height: min(52vh, 430px); overflow-y: auto; padding: 6px 8px 10px; overscroll-behavior: contain; }
  .gl { padding: 14px 12px 6px; font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-2); }
  .it { display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: center; width: 100%; padding: 11px 12px; border-radius: 10px; text-align: left; font-size: 15.5px; position: relative; scroll-margin: 44px 0 12px; }
  .it[hidden], .grp[hidden] { display: none; }
  .it .h { font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-2); white-space: nowrap; }
  .it[aria-selected='true'] { background: var(--bg-2); }
  .it[aria-selected='true']::before { content: ''; position: absolute; left: 0; top: 10px; bottom: 10px; width: 2px; border-radius: 2px; background: var(--accent); }
  .it[aria-selected='true'] .h { color: var(--accent); }
  .empty { padding: 28px 12px; color: var(--ink-2); font-size: 15px; }
  .foot { display: flex; gap: 20px; padding: 11px 18px; border-top: 1px solid var(--hair); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-2); }
  .foot span { display: inline-flex; align-items: center; gap: 6px; }
  .foot kbd { padding: 1px 5px; }
  .cmdk[open] { animation: cmdk-in 0.4s var(--ease-out) both; }
  .cmdk[open]::backdrop { animation: cmdk-fade 0.3s var(--ease-out) both; }
  @keyframes cmdk-in { from { opacity: 0; transform: translateY(-10px) scale(0.98); } }
  @keyframes cmdk-fade { from { opacity: 0; } }
  @media (max-width: 860px) {
    .cmdk { margin-top: 76px; }
    .foot { display: none; }
    .it { padding-block: 13px; }
  }
  @media (prefers-reduced-motion: reduce) { .cmdk[open], .cmdk[open]::backdrop { animation: none; } }
</style>
