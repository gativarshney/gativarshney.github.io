---
<dialog class="lightbox" data-lightbox-dialog aria-label="Image preview">
  <button type="button" class="lb-close" data-lightbox-close aria-label="Close preview">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <figure>
    <img alt="" />
    <figcaption class="mono"></figcaption>
  </figure>
</dialog>

<style>
  .lightbox { border: 0; padding: 0; background: transparent; max-width: none; max-height: none; width: 100vw; height: 100dvh; margin: 0; inset: 0; color: var(--ink); }
  .lightbox::backdrop { background: color-mix(in oklch, var(--bg) 86%, transparent); backdrop-filter: blur(18px) saturate(1.2); -webkit-backdrop-filter: blur(18px) saturate(1.2); }
  .lightbox figure { margin: 0; width: 100%; height: 100%; display: grid; place-items: center; align-content: center; gap: 16px; padding: clamp(16px, 4vw, 48px); box-sizing: border-box; }
  .lightbox img { max-width: min(1400px, 100%); max-height: calc(100dvh - 120px); width: auto; height: auto; border-radius: 8px; box-shadow: 0 40px 100px -30px oklch(0% 0 0 / 0.5); border: 1px solid var(--hair); background: var(--bg-2); }
  .lightbox figcaption { font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-2); text-align: center; }
  .lb-close { position: fixed; top: 20px; right: 20px; width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--hair-strong); background: var(--bg); color: var(--ink); display: grid; place-items: center; z-index: 2; transition: transform 0.5s var(--ease-out), background-color 0.3s; }
  .lb-close:hover { transform: rotate(90deg); background: var(--bg-2); }
  .lightbox[open] { animation: lb-in 0.5s var(--ease-out) both; }
  .lightbox[open]::backdrop { animation: lb-fade 0.4s var(--ease-out) both; }
  .lightbox[open] img { animation: lb-img 0.6s var(--ease-out) both; }
  @keyframes lb-in { from { opacity: 0; } }
  @keyframes lb-fade { from { opacity: 0; } }
  @keyframes lb-img { from { opacity: 0; transform: translateY(18px) scale(0.97); } }
  @media (prefers-reduced-motion: reduce) { .lightbox[open], .lightbox[open]::backdrop, .lightbox[open] img { animation: none; } }
</style>
