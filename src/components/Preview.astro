---
/**
 * A browser-framed preview of an external page.
 * live=true embeds the real page in a scaled iframe (only for sites that allow framing).
 * Otherwise a build-time snapshot image is shown, linking out to the page.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  url: string;
  title: string;
  live?: boolean;
  image?: ImageMetadata;
  alt?: string;
  ratio?: string;   // css aspect-ratio for the body
  base?: number;    // virtual width the live page is laid out at
  label?: string;   // text shown in the address bar
}
const { url, title, live = false, image, alt = title, ratio = '16 / 10', base = 1280, label } = Astro.props;
const shown = label ?? url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---
<div class="preview" data-tilt="2">
  <div class="pbar">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="purl mono" title={url}>{shown}</span>
    <a class="popen mono" href={url} target="_blank" rel="noopener">Open ↗</a>
  </div>
  <div class="pbody" style={`aspect-ratio:${ratio}`} data-scale-frame={live ? base : undefined} data-cursor-hide={live ? '' : undefined}>
    {live ? (
      <>
        <iframe class="live-only" data-src={url} title={title} loading="lazy" referrerpolicy="no-referrer" style={`width:${base}px`}></iframe>
        {image && (
          <a class="snap static-only" href={url} target="_blank" rel="noopener" data-cursor="Open" aria-label={`Open ${title}`}>
            <Image src={image} alt={alt} widths={[640, 960]} sizes="92vw" loading="lazy" />
          </a>
        )}
        <noscript><a class="snap empty" href={url} target="_blank" rel="noopener">{title} ↗</a></noscript>
      </>
    ) : image ? (
      <a class="snap" href={url} target="_blank" rel="noopener" data-cursor="Open" aria-label={`Open ${title}`}>
        <Image src={image} alt={alt} widths={[640, 960, 1280]} sizes="(max-width: 860px) 92vw, 44vw" loading="lazy" />
      </a>
    ) : (
      <a class="snap empty" href={url} target="_blank" rel="noopener">{title} ↗</a>
    )}
  </div>
  {live && <p class="pfall mono"><a href={url} target="_blank" rel="noopener">If the embed does not load, open the live page ↗</a></p>}
</div>

<style>
  .preview { border: 1px solid var(--hair); border-radius: 12px; background: var(--bg-2); overflow: hidden; transform-style: preserve-3d; transform: perspective(1100px); transition: border-color 0.5s var(--ease-out), box-shadow 0.6s var(--ease-out); box-shadow: 0 1px 0 0 oklch(100% 0 0 / 0.5) inset, 0 20px 50px -30px oklch(0% 0 0 / 0.35); }
  .preview:hover { border-color: var(--hair-strong); }
  .pbar { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-bottom: 1px solid var(--hair); }
  .dots { display: inline-flex; gap: 5px; }
  .dots i { width: 8px; height: 8px; border-radius: 50%; background: var(--hair-strong); display: block; }
  .purl { flex: 1; font-size: 11px; letter-spacing: 0.04em; color: var(--ink-2); padding: 5px 10px; border-radius: 999px; background: var(--bg); border: 1px solid var(--hair); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .popen { font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-2); transition: color 0.3s; }
  .popen:hover { color: var(--accent); }
  .pbody { position: relative; overflow: hidden; background: #fff; }
  .pbody iframe { position: absolute; inset: 0; border: 0; height: calc(100% / var(--s, 0.5)); transform: scale(var(--s, 0.5)); transform-origin: 0 0; background: #fff; }
  .snap { display: block; position: absolute; inset: 0; overflow: hidden; }
  .snap :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; transition: transform 1.2s var(--ease-out); }
  .snap:hover :global(img) { transform: scale(1.02); }
  .snap.empty { display: grid; place-items: center; font-family: var(--font-mono); font-size: 12px; color: var(--ink-2); }
  .pfall { margin: 0; padding: 8px 12px; font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); border-top: 1px solid var(--hair); }
  .pfall a:hover { color: var(--accent); }
  .static-only { display: none; }
  @media (pointer: coarse), (max-width: 860px) {
    .pbody:has(.static-only) .live-only { display: none; }
    .static-only { display: block; }
    .pbody:has(.static-only) ~ .pfall { display: none; }
  }
</style>
