---
import type { Entry } from '@/data/site';
import Visual from '@/components/Visual.astro';

interface Props { entry: Entry; num: string; }
const { entry: w, num } = Astro.props;
---
<article class="entry" id={w.slug}>
  <hr class="hr" data-line />
  <div class="entry-grid">
    <div class="num mono" data-reveal data-node><span class="node" aria-hidden="true"></span>{num}</div>
    <div class="entry-copy">
      <p class="kicker mono" data-reveal>{w.kicker}<span class="period"> · {w.period}</span></p>
      <h3 class="display" data-reveal="0.05">{w.href ? <a href={w.href} data-cursor="Open">{w.title}</a> : <span>{w.title}</span>}</h3>
      <div class="tags" data-reveal="0.1">
        {w.status && <span class:list={['tag', w.status.tone]}>{w.status.label}</span>}
        {w.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
      <p class="summary" data-reveal="0.15">{w.summary}</p>
      {w.evidence.length > 0 && (
        <div class="ev" data-reveal-group="0.1">
          {w.evidence.map((e) => (<div><span class="stat">{e.value}</span><span class="lab">{e.label}</span></div>))}
        </div>
      )}
      {w.links.length > 0 && (
        <p class="links" data-reveal="0.2">
          {w.links.map((l) => (
            <a class="u" href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>{l.label}{l.external ? ' ↗' : ' →'}</a>
          ))}
        </p>
      )}
    </div>
    <div class="entry-visual" data-reveal="0.1">
      <slot><Visual kind={w.visual} /></slot>
    </div>
  </div>
</article>

<style>
  .entry-grid { display: grid; grid-template-columns: 72px 1fr 1.05fr; gap: 40px; padding: clamp(40px, 5vw, 64px) 0; align-items: start; }
  .num { position: relative; font-size: 13px; color: var(--ink-2); padding: 10px 0 0 24px; transition: color 0.4s; }
  .node { position: absolute; left: 0; top: 14px; width: 10px; height: 10px; border-radius: 50%; background: var(--bg); border: 2px solid var(--hair-strong); transition: border-color 0.4s, background-color 0.4s, transform 0.5s var(--ease-out); }
  .num.is-on { color: var(--accent); }
  .num.is-on .node { border-color: var(--accent); background: var(--accent); transform: scale(1.15); }
  .kicker { font-size: 11.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-2); margin-bottom: 14px; }
  .period { color: var(--ink-3); }
  h3 { font-size: clamp(34px, 3.6vw, 52px); margin-bottom: 18px; }
  h3 a { background-image: linear-gradient(currentColor, currentColor); background-size: 0% 2px; background-repeat: no-repeat; background-position: 0 96%; transition: background-size 0.6s var(--ease-out), color 0.3s; }
  h3 a:hover { background-size: 100% 2px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
  .summary { color: var(--ink-2); max-width: 540px; margin-bottom: 26px; }
  .ev { display: flex; flex-wrap: wrap; gap: 22px 36px; }
  .ev .stat { font-size: clamp(30px, 2.6vw, 38px); }
  .ev .lab { display: block; margin-top: 8px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); }
  .links { margin-top: 28px; font-size: 14.5px; display: flex; flex-wrap: wrap; gap: 8px 26px; }
  .links a { color: var(--ink-2); transition: color 0.3s; }
  .links a:hover { color: var(--ink); }
  .entry-visual { display: grid; gap: 18px; }
  @media (max-width: 1024px) {
    .entry-grid { grid-template-columns: 56px 1fr; }
    .entry-visual { grid-column: 2; }
  }
  @media (max-width: 860px) {
    .entry-grid { grid-template-columns: 1fr; gap: 20px; padding-left: 26px; }
    .num { padding-left: 0; }
    .node { left: -26px; }
    .entry-visual { grid-column: 1; }
    h3 { font-size: 32px; }
  }
</style>
