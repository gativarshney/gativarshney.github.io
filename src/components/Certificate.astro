---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  title: string;
  meta?: string;
  verify?: string;
  compact?: boolean;
}
const { src, alt, title, meta, verify, compact = false } = Astro.props;
const full = await getImage({ src, width: 2000, format: 'webp', quality: 82 });
---
<figure class:list={['cert', { compact }]}>
  <button type="button" class="cert-btn" data-lightbox={full.src} data-lightbox-alt={alt} data-lightbox-caption={`${title}${meta ? ' · ' + meta : ''}`} data-cursor="View" aria-label={`View certificate: ${title}`}>
    <Image src={src} alt={alt} widths={[480, 800, 1200]} sizes={compact ? '(max-width: 860px) 60vw, 22vw' : '(max-width: 860px) 92vw, 44vw'} loading="lazy" />
    <span class="sheen" aria-hidden="true"></span>
    <span class="zoom mono" aria-hidden="true">View</span>
  </button>
  <figcaption>
    <span class="t">{title}</span>
    {meta && <span class="m mono">{meta}</span>}
    {verify && <a class="v mono" href={verify} target="_blank" rel="noopener">Verify ↗</a>}
  </figcaption>
</figure>

<style>
  .cert { margin: 0; }
  .cert-btn {
    position: relative; display: block; width: 100%; border-radius: 8px; overflow: hidden;
    border: 1px solid var(--hair); background: var(--bg-2);
    transform: perspective(1000px) translateY(0);
    transition: transform 0.7s var(--ease-out), box-shadow 0.7s var(--ease-out), border-color 0.4s;
    box-shadow: 0 1px 0 0 oklch(100% 0 0 / 0.5) inset, 0 12px 32px -20px oklch(0% 0 0 / 0.35);
  }
  .cert-btn:hover { transform: perspective(1000px) rotateX(1.5deg) translateY(-4px); box-shadow: 0 1px 0 0 oklch(100% 0 0 / 0.5) inset, 0 28px 48px -24px oklch(0% 0 0 / 0.45); border-color: var(--hair-strong); }
  .cert-btn :global(img) { display: block; width: 100%; height: auto; }
  .sheen { position: absolute; inset: 0; background: linear-gradient(115deg, transparent 35%, oklch(100% 0 0 / 0.28) 50%, transparent 65%); transform: translateX(-120%); transition: transform 0.9s var(--ease-out); pointer-events: none; }
  .cert-btn:hover .sheen { transform: translateX(120%); }
  .zoom { position: absolute; right: 10px; bottom: 10px; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; padding: 6px 10px; border-radius: 999px; background: var(--ink); color: var(--bg); opacity: 0; transform: translateY(6px); transition: opacity 0.35s, transform 0.5s var(--ease-out); }
  .cert-btn:hover .zoom { opacity: 1; transform: none; }
  figcaption { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: baseline; margin-top: 12px; font-size: 14.5px; }
  .compact figcaption { font-size: 13.5px; margin-top: 10px; }
  .t { font-weight: 500; }
  .m { font-size: 11px; color: var(--ink-2); letter-spacing: 0.06em; text-transform: uppercase; }
  .v { font-size: 10.5px; color: var(--ink-2); letter-spacing: 0.1em; text-transform: uppercase; margin-left: auto; border-bottom: 1px solid var(--hair); }
  .v:hover { color: var(--accent); border-color: var(--accent); }
</style>
