---
import { site, nav } from '@/data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div>
        <a class="brand" href="/">Gati <em>Varshney</em></a>
        <p class="say">Have something worth building? <a class="u" href={`mailto:${site.email}?subject=Hello%20Gati`}>Start a conversation ↗</a></p>
      </div>
      <nav aria-label="Footer" class="cols">
        <div>
          <p class="eyebrow">Index</p>
          {nav.map((n) => <a class="u" href={n.href}>{n.label}</a>)}
        </div>
        <div>
          <p class="eyebrow">Elsewhere</p>
          <a class="u" href={site.links.github} target="_blank" rel="noopener me">GitHub</a>
          <a class="u" href={site.links.linkedin} target="_blank" rel="noopener me">LinkedIn</a>
          <a class="u" href={site.links.leetcode} target="_blank" rel="noopener me">LeetCode</a>
          <a class="u" href={site.links.medium} target="_blank" rel="noopener me">Medium</a>
        </div>
        <div>
          <p class="eyebrow">Contact</p>
          <a class="u" href={`mailto:${site.email}`}>{site.email}</a>
          <a class="u" href={site.links.resume} target="_blank" rel="noopener">Résumé (PDF)</a>
          <a class="u" href="/rss.xml">RSS</a>
        </div>
      </nav>
    </div>
    <div class="bottom">
      <span>© {year} Gati Varshney · India · open to relocation</span>
      <span>Built with Astro · set in Fraunces &amp; Geist · hosted on GitHub Pages · <a class="u" href={site.links.source} target="_blank" rel="noopener">source</a> · updated {site.updated}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { margin-top: clamp(96px, 12vw, 160px); border-top: 1px solid var(--hair); padding: 56px 0 40px; }
  .top { display: grid; grid-template-columns: 1fr 2fr; gap: 40px; align-items: start; }
  .brand { font-family: var(--font-display); font-size: clamp(32px, 4vw, 52px); letter-spacing: -0.02em; line-height: 1; }
  .brand em { font-style: italic; font-weight: 300; color: var(--accent); }
  .say { margin-top: 18px; font-size: 15px; color: var(--ink-2); max-width: 300px; }
  .say a { color: var(--ink); }
  .cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .cols div { display: flex; flex-direction: column; gap: 10px; font-size: 15px; }
  .cols .eyebrow { margin-bottom: 8px; }
  .cols a { width: fit-content; color: var(--ink-2); transition: color 0.3s; }
  .cols a:hover { color: var(--ink); }
  .bottom { display: flex; justify-content: space-between; gap: 24px; margin-top: 56px; padding-top: 22px; border-top: 1px solid var(--hair); font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.04em; color: var(--ink-2); }
  @media (max-width: 860px) {
    .top { grid-template-columns: 1fr; }
    .cols { grid-template-columns: 1fr 1fr; }
    .bottom { flex-direction: column; gap: 10px; }
  }
</style>
