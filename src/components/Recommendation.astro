---
/**
 * A LinkedIn recommendation, quoted verbatim. The pull line is one sentence of
 * the full text; the rest sits behind a disclosure so the page stays short.
 */
import { site, recommendation as r } from '@/data/site';
const initials = r.author.split(' ').map((p) => p[0]).slice(0, 2).join('');
---
<section class="section wrap rec" id="recommendation">
  <div class="side">
    <p class="eyebrow" data-reveal>In a mentor’s words</p>
    <div class="who" data-reveal="0.1">
      <span class="gram display" aria-hidden="true">{initials}</span>
      <div>
        <p class="name">{r.author}</p>
        <p class="role">{r.role}</p>
        <p class="rel mono">{r.relation} · {r.dateLabel}</p>
      </div>
    </div>
    <p class="src mono" data-reveal="0.15"><a class="u" href={r.href} target="_blank" rel="noopener">Recommendation on LinkedIn ↗</a></p>
  </div>

  <figure class="quote">
    <span class="mark display" aria-hidden="true">“</span>
    <blockquote cite={site.links.linkedin}>
      <p class="pull display" data-read>{r.pull[0]}<em>{r.pull[1]}</em></p>
      <details data-reveal="0.1">
        <summary class="mono"><span class="open">Read the full recommendation</span><span class="shut">Hide the full recommendation</span><span class="plus" aria-hidden="true"></span></summary>
        <div class="full">{r.body.map((p) => <p>{p}</p>)}</div>
      </details>
    </blockquote>
    <figcaption class="sr">{r.author}, {r.role}. {r.relation}, {r.dateLabel}.</figcaption>
  </figure>
</section>

<style>
  .rec { display: grid; grid-template-columns: 0.32fr 0.68fr; gap: 40px; align-items: start; }
  .rec > :global(*) { min-width: 0; }
  .who { display: flex; align-items: center; gap: 16px; margin-top: 28px; }
  .gram { flex: none; width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; font-size: 21px; font-style: italic; letter-spacing: 0; color: var(--accent); background: radial-gradient(circle at 35% 30%, oklch(100% 0 0 / 0.55), transparent 60%), var(--accent-soft); border: 1px solid color-mix(in oklch, var(--accent) 35%, transparent); }
  .name { font-weight: 500; font-size: 17px; line-height: 1.3; }
  .role { font-size: 15px; color: var(--ink-2); }
  .rel { margin-top: 6px; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); }
  .src { margin-top: 22px; font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-2); }

  .quote { margin: 0; position: relative; }
  .mark { display: block; height: 0.42em; font-size: clamp(96px, 11vw, 168px); line-height: 0.82; font-style: italic; font-weight: 300; color: var(--accent); user-select: none; }
  blockquote { margin: 0; }
  .pull { font-size: clamp(28px, 3.7vw, 54px); line-height: 1.14; font-weight: 300; letter-spacing: -0.02em; text-wrap: pretty; }
  details { margin-top: clamp(28px, 3.4vw, 44px); border-top: 1px solid var(--hair); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 0; list-style: none; font-size: 11.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-2); transition: color 0.3s var(--ease-out); }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--accent); }
  details .shut, details[open] .open { display: none; }
  details[open] .shut { display: inline; }
  .plus { position: relative; flex: none; width: 13px; height: 13px; }
  .plus::before, .plus::after { content: ''; position: absolute; left: 0; top: 6px; width: 13px; height: 1px; background: currentColor; transition: transform 0.5s var(--ease-out); }
  .plus::after { transform: rotate(90deg); }
  details[open] .plus::after { transform: rotate(0deg); }
  .full { padding: 4px 0 8px 22px; border-left: 2px solid var(--accent); max-width: 720px; animation: rec-in 0.6s var(--ease-out) both; }
  .full p { font-size: 17px; color: var(--ink-2); margin-bottom: 16px; }
  .full p:last-child { margin-bottom: 0; }
  @keyframes rec-in { from { opacity: 0; transform: translateY(8px); } }
  details[open] { padding-bottom: 22px; border-bottom: 1px solid var(--hair); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 860px) {
    .rec { grid-template-columns: 1fr; gap: 28px; }
    .who { margin-top: 20px; }
    .mark { font-size: 96px; }
  }
  @media (prefers-reduced-motion: reduce) { .full { animation: none; } }
</style>
